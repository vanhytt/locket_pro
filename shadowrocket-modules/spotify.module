#!name=Spotify Premium Unlock
#!desc=Mở khóa một phần Spotify Premium — skip bài, nghe đầy đủ, không ads
#!author=Adapted from dhungx
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
# ─────────────────────────────────────────────────
# Lưu ý:
# - Mở khóa một phần premium (nghe nhạc đầy đủ, skip, không quảng cáo)
# - KHÔNG thể thiết lập chất lượng âm thanh cao cấp (Very High / Lossless)
# - Dùng binary-body-mode vì Spotify giao tiếp bằng Protobuf
# - Khuyến nghị đăng nhập lại sau khi cài module
# ─────────────────────────────────────────────────

[MITM]
hostname = %APPEND% spclient.wg.spotify.com

[Script]
# Modify protobuf response từ bootstrap & customize endpoint
spotify-proto = type=http-response, pattern=^https:\/\/spclient\.wg\.spotify\.com\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$, requires-body=1, binary-body-mode=1, max-size=0, script-path=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/js/spotify/spotify.js, script-update-interval=0
