#!name=Locket Gold Unlock
#!desc=Mở khóa Locket Gold — Unlock tất cả tính năng Premium
#!author=Adapted from dhungx
#!icon=https://is1-ssl.mzstatic.com/image/thumb/Purple221/v4/locket-icon.png
# ─────────────────────────────────────────────────
# Cách hoạt động:
# 1. Chặn cache headers của RevenueCat (http-request) → buộc server trả full response
# 2. Modify response từ RevenueCat API → fake trạng thái đã mua Gold subscription
# ─────────────────────────────────────────────────

[Script]
# Xóa cache headers (ETag, If-None-Match) để bypass 304 Not Modified
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/js/locket/deleteHeader.js, timeout=60

# Modify response body: thêm subscription Gold vào JSON trả về
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/js/locket/Locket.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
