#!url=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/all-in-one.module
#!name=All-In-One Unlock
#!desc=Tổng hợp: Locket Gold + Spotify Premium + YouTube BlockAd + PiP + SoundCloud Go+
#!author=YourName
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
# ─────────────────────────────────────────────────
# Bao gồm:
#  ✅ Locket Gold
#  ✅ Spotify Premium (một phần)
#  ✅ YouTube: chặn quảng cáo, bật PiP, phát nền, 4K
#  ✅ SoundCloud Go+
# ─────────────────────────────────────────────────

# ══════════════════════════════════════════════════
# MITM — Tổng hợp tất cả hostname cần giải mã TLS
# ══════════════════════════════════════════════════
[MITM]
hostname = %APPEND% api.revenuecat.com, spclient.wg.spotify.com, redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com, api-mobile.soundcloud.com

# ══════════════════════════════════════════════════
# RULE — Chặn quảng cáo YouTube
# ══════════════════════════════════════════════════
[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com), (PROTOCOL,UDP)),REJECT
DOMAIN-SUFFIX,ads.youtube.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT

# ══════════════════════════════════════════════════
# URL REWRITE — Reject tracking / ads URL
# ══════════════════════════════════════════════════
[URL Rewrite]
(^https?://[\w-]+\.googlevideo\.com/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https?://[\w-]+\.googlevideo\.com/(?!(dclk_video_ads|videoplayback?)).+&oad _ reject-200
^https?://(www|s)\.youtube\.com/api/stats/ads _ reject-200
^https?://(www|s)\.youtube\.com/(pagead|ptracking) _ reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext _ reject-200
^https?://(www|s)\.youtube\.com/get_midroll_info _ reject-200
^https?://(www|s)\.youtube\.com/get_vmap _ reject-200

# ══════════════════════════════════════════════════
# SCRIPT — Tất cả các unlock
# ══════════════════════════════════════════════════
[Script]

# ── Locket Gold Unlock ──
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), timeout=60, script-path=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/js/locket/deleteHeader.js
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), requires-body=true, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/js/locket/Locket.js

# ── Spotify Premium Unlock ──
spotify-proto = type=http-response, pattern=^https:\/\/spclient\.wg\.spotify\.com\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$, requires-body=1, binary-body-mode=1, max-size=0, script-path=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/js/spotify/spotify.js, script-update-interval=0

# ── YouTube Premium + BlockAd ──
youtube.response = type=http-response, pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch), requires-body=1, max-size=-1, binary-body-mode=1, engine=script, script-path=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/js/youtube/response.js, timeout=60

# ── SoundCloud Go+ Unlock ──
SoundCloudGo+ = type=http-response, pattern=^https://api-mobile\.soundcloud\.com/configuration/ios, requires-body=1, max-size=-1, timeout=60, script-path=https://raw.githubusercontent.com/YOU/YOUR-REPO/main/js/soundcloud/soundcloud.js
