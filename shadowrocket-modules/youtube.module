#!name=YouTube BlockAd + PiP + Background
#!desc=Chặn quảng cáo YouTube, bật PiP, phát trong nền — Full AdBlock (Video, Banner, Tracking)
#!author=Adapted from dhungx
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
# ─────────────────────────────────────────────────
# Cách hoạt động:
# [Rule]        → Chặn quảng cáo qua UDP/QUIC + domain-level reject
# [URL Rewrite] → Reject CDN quảng cáo & URL tracking theo regex
# [Script]      → Inject JS vào response YouTube API (bật PiP, background, remove ads)
# [MITM]        → Giải mã HTTPS để can thiệp response body
# ─────────────────────────────────────────────────

# ══════════════════════════════════════════════════
# [Rule] — Chặn quảng cáo & tracking ở tầng DNS/domain
# Ưu tiên xử lý trước khi request đi ra ngoài
# ══════════════════════════════════════════════════
[Rule]
# ── Chặn QUIC/UDP để tránh bypass MITM ──
# YouTube dùng QUIC (UDP) để tải video — cần REJECT để buộc về TCP/HTTPS
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

# ── Chặn ad-serving domains ──
DOMAIN-SUFFIX,ads.youtube.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT

# ── Bổ sung: Chặn ad network & syndication ──
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT

# ── Bổ sung: Chặn keyword tracking YouTube Ads ──
DOMAIN-KEYWORD,youtubeads,REJECT

# ══════════════════════════════════════════════════
# [URL Rewrite] — Reject quảng cáo & tracking theo regex URL
# Hoạt động ở tầng HTTP — chính xác hơn domain-level blocking
# ══════════════════════════════════════════════════
[URL Rewrite]
# ── Xóa tham số giới hạn chất lượng video (ctier=L → bỏ giới hạn 1080p) ──
(^https?://[\w-]+\.googlevideo\.com/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

# ── Reject CDN delivery của quảng cáo video (trả 200 rỗng, không block video thật) ──
^https?://[\w-]+\.googlevideo\.com/(?!(dclk_video_ads|videoplayback?)).+&oad _ reject-200

# ── Reject các endpoint tracking stats của YouTube Ads ──
^https?://(www|s)\.youtube\.com/api/stats/ads _ reject-200
^https?://(www|s)\.youtube\.com/(pagead|ptracking) _ reject-200
^https?://s\.youtube\.com/api/stats/qoe\?adcontext _ reject-200

# ── Reject các endpoint video mid-roll & pre-roll ads ──
^https?://(www|s)\.youtube\.com/get_midroll_info _ reject-200
^https?://(www|s)\.youtube\.com/get_vmap _ reject-200

# ── Reject các endpoint ad companion & overlay ──
^https?://(www|s)\.youtube\.com/api/stats/watchtime\?.*cpn.* _ reject-200
^https?://www\.youtube\.com/pagead/adview.* _ reject-200

# ══════════════════════════════════════════════════
# [Script] — Can thiệp response body từ YouTube API
# binary-body-mode=1: YouTube dùng Protobuf (binary), không phải JSON thuần
# engine=script: dùng JS engine mới nhất của Shadowrocket
# ══════════════════════════════════════════════════
[Script]
# ── Modify YouTube API response: bật PiP, Background Play, loại bỏ ad slots ──
youtube.response = type=http-response, pattern=^https://youtubei\.googleapis\.com/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch), requires-body=1, max-size=-1, binary-body-mode=1, engine=script, timeout=60, script-path=https://raw.githubusercontent.com/vanhytt/locket_pro/main/shadowrocket-modules/js/youtube/response.js

# ══════════════════════════════════════════════════
# [MITM] — Giải mã TLS/HTTPS để Script có thể đọc body
# ⚠️ BẮT BUỘC với mọi https Script/Rewrite
# *.youtube.com bao phủ: www, s, music, studio...
# *.googlevideo.com bao phủ: CDN video streams
# ══════════════════════════════════════════════════
[MITM]
hostname = %APPEND% *.youtube.com, youtubei.googleapis.com, *.googlevideo.com, redirector*.googlevideo.com
